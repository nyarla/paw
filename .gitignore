# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
# ビルド成果物（workspace 内の各クレート・アプリ配下も含む）
/target/
**/target/

# rustc / rust-analyzer の一時ファイル
*.rs.bk
*.rlib
*.rmeta

# ベンチ・プロファイリング
/criterion/
perf.data
perf.data.*
flamegraph.svg
callgrind.out.*
massif.out.*

# カバレッジ
*.profraw
*.profdata
/lcov.info
/coverage/
/tarpaulin-report.*

# Cargo.lock はアプリケーション（paw / pawd）を含むためコミットする。
# ライブラリ専用クレートを切り出した場合のみ、そのクレート配下で個別に無視する。

# ---------------------------------------------------------------------------
# PAW audio wire: ビルド済みプラグイン / 配布物
# ---------------------------------------------------------------------------
# CLAP バンドル（paw-audio-wire.clap やテストプラグイン）
*.clap
/dist/
/artifacts/
/bundles/

# テスト用プラグインの生成物が target 外へ出力される場合
/test-plugins/bin/
/test-plugins/out/

# ---------------------------------------------------------------------------
# PAW audio wire: ローカル実行時の生成物
# ---------------------------------------------------------------------------
# endpoint JSON / pawd.lock / spawn lock（通常は $XDG_RUNTIME_DIR/paw 配下）
/.paw/
/pawd.lock
/pawd*.lock
/endpoint*.json

# ローカル検証用の設定ファイル（雛形は *.example.toml としてコミットする）
/paw-client.toml
/paw-host.toml

# state / パケットキャプチャ / プロトコルデバッグ用ダンプ
*.pawstate
*.pcap
*.pcapng
/debug-out/

# ログ
*.log
/logs/

# ---------------------------------------------------------------------------
# Wine（Phase 2: Wine Host）
# ---------------------------------------------------------------------------
# Wine prefix はリポジトリに含めない
/.wine/
/.wine-*/
/wineprefix/
*.wineprefix/
*.dmp

# ---------------------------------------------------------------------------
# 環境変数・シークレット
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# エディタ / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.fleet/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Nix（使用する場合）
# ---------------------------------------------------------------------------
/result
/result-*
